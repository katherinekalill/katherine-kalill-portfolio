---
import CaseStudy from '../../components/CaseStudy.astro';
import { loadSiteContent } from '../../lib/content/site-content';

export async function getStaticPaths() {
  const content = await loadSiteContent();
  const featuredIndex = new Map(
    content.featured.map((project, index) => [project.slug, index]),
  );
  return content.projects.map((project) => {
    const index = content.published
      ? featuredIndex.get(project.slug)
      : undefined;
    return {
      params: { slug: project.slug },
      props: {
        project,
        media: content.media,
        previous: index === undefined ? undefined : content.featured[index - 1],
        next: index === undefined ? undefined : content.featured[index + 1],
      },
    };
  });
}

const { project, media, previous, next } = Astro.props;
---

<CaseStudy project={project} media={media} previous={previous} next={next} />
