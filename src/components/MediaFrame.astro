---
import { routeHref, mediaStyle } from '../lib/site';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: string | ImageMetadata;
  alt?: string;
  decorative?: boolean;
  focalPoint?: { x: number; y: number };
  caption?: string | undefined;
  credit?: string | null;
  width?: number;
  height?: number;
  parallax?: boolean;
  loading?: 'eager' | 'lazy';
  srcSet?: string | undefined;
  sizes?: string | undefined;
  ratio?: number;
  layout?: 'portrait' | 'landscape' | 'full-bleed' | 'detail';
  fit?: 'cover' | 'natural';
  hoverZoom?: boolean;
}

const {
  src,
  alt = '',
  decorative = false,
  focalPoint = { x: 0.5, y: 0.5 },
  caption,
  credit,
  width = 1600,
  height = 1000,
  parallax = false,
  loading = 'lazy',
  srcSet,
  sizes,
  ratio,
  layout,
  fit = 'cover',
  hoverZoom = false,
} = Astro.props;
const mediaAspect = ratio ?? width / height;
---

<figure
  class:list={[
    'media-frame',
    layout && `media-frame--${layout}`,
    fit === 'natural' && 'media-frame--natural',
  ]}
  style={`${mediaStyle(focalPoint)}; --media-aspect: ${mediaAspect}`}
>
  <div
    class="media-frame__content"
    style={`aspect-ratio: ${ratio ?? `${width} / ${height}`}`}
  >
    {typeof src === 'string' ? (
      <div
        class:list={[
          'media-frame__zoom',
          hoverZoom && 'media-frame__zoom--enabled',
        ]}
      >
        <img
          class={parallax ? 'media-frame__image' : undefined}
          src={routeHref(src)}
          alt={decorative ? '' : alt}
          width={width}
          height={height}
          loading={loading}
          decoding="async"
          srcset={srcSet}
          sizes={sizes}
          data-parallax={parallax ? '' : undefined}
        />
      </div>
    ) : src ? (
      <div
        class:list={[
          'media-frame__zoom',
          hoverZoom && 'media-frame__zoom--enabled',
        ]}
      >
        <Image
          class={parallax ? 'media-frame__image' : undefined}
          src={src}
          alt={decorative ? '' : alt}
          loading={loading}
          decoding="async"
          sizes={sizes}
          data-parallax={parallax ? '' : undefined}
          style={mediaStyle(focalPoint)}
        />
      </div>
    ) : (
      <div class="media-frame__placeholder" aria-hidden="true"></div>
    )}
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="media-frame__credit">Photo: {credit}</span>}
    </figcaption>
  )}
</figure>
