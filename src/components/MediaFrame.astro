---
import { routeHref, mediaStyle } from '../lib/site';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: string | ImageMetadata;
  alt?: string;
  decorative?: boolean;
  focalPoint?: { x: number; y: number };
  caption?: string;
  credit?: string | null;
  width?: number;
  height?: number;
  parallax?: boolean;
}

const {
  src,
  alt = '',
  decorative = false,
  focalPoint = { x: 0.5, y: 0.5 },
  caption,
  credit,
  width = 1600,
  height = 1000,
  parallax = false,
} = Astro.props;
---

<figure class="media-frame" style={mediaStyle(focalPoint)}>
  <div
    class="media-frame__content"
    style={`aspect-ratio: ${width} / ${height}`}
  >
    {typeof src === 'string' ? (
      <img
        class={parallax ? 'media-frame__image' : undefined}
        src={routeHref(src)}
        alt={decorative ? '' : alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        data-parallax={parallax ? '' : undefined}
      />
    ) : src ? (
      <Image
        class={parallax ? 'media-frame__image' : undefined}
        src={src}
        alt={decorative ? '' : alt}
        loading="lazy"
        decoding="async"
        data-parallax={parallax ? '' : undefined}
        style={mediaStyle(focalPoint)}
      />
    ) : (
      <div class="media-frame__placeholder" aria-hidden="true"></div>
    )}
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="media-frame__credit">Photo: {credit}</span>}
    </figcaption>
  )}
</figure>
