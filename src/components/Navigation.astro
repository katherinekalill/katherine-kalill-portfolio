---
import { routeHref } from '../lib/site';
import type { SiteNavigationItem } from '../lib/navigation';

interface Props {
  label: string;
  items: SiteNavigationItem[];
  panelId?: string;
}

const { label, items, panelId = 'site-navigation-items' } = Astro.props;
---

<nav class="site-navigation" aria-label={label} data-site-navigation>
  {items.length > 1 && (
    <button
      class="site-navigation__toggle"
      type="button"
      aria-expanded="true"
      aria-controls={panelId}
      data-menu-toggle
      hidden
    >
      <span>Menu</span>
      <span aria-hidden="true">+</span>
    </button>
  )}
  <div class="site-navigation__items" id={panelId} data-menu-panel>
    {items.map(({ href, label: linkLabel, sectionId, current }) => (
      <a
        href={href.startsWith('/') ? routeHref(href) : href}
        data-section-id={sectionId}
        aria-current={current}
      >
        {linkLabel}
      </a>
    ))}
  </div>
</nav>
