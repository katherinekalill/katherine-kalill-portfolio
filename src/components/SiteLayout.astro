---
import '../styles/global.css';
import { routeHref } from '../lib/site';
import { siteConfig } from '../lib/site-config';
import {
  createSiteNavigation,
  type SiteNavigationItem,
} from '../lib/navigation';
import Navigation from './Navigation.astro';
import manropeFont from '../assets/fonts/manrope-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  navigation?: SiteNavigationItem[];
  homeHref?: string;
  homeIsCurrent?: boolean;
  reviewLabel?: string | undefined;
  robots?: 'index,follow' | 'noindex,nofollow';
  ogType?: 'website' | 'article';
  creativeWork?: { name: string; description: string };
}
const {
  title,
  description,
  navigation = createSiteNavigation(Astro.url.pathname),
  homeHref = '/',
  homeIsCurrent = false,
  reviewLabel,
  robots = 'index,follow',
  ogType = 'website',
  creativeWork,
} = Astro.props;
const canonical = Astro.site
  ? new URL(routeHref(Astro.url.pathname), Astro.site)
  : undefined;
const shareImage = Astro.site
  ? new URL(routeHref('/work/freaks-of-nature-hero.webp'), Astro.site)
  : undefined;
const personId = Astro.site
  ? `${new URL(routeHref('/'), Astro.site).href}#person`
  : undefined;
const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: siteConfig.name,
  url: Astro.site ? new URL(routeHref('/about/'), Astro.site).href : undefined,
  sameAs: [siteConfig.linkedin],
};
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: Astro.site ? new URL(routeHref('/'), Astro.site).href : undefined,
  publisher: personId ? { '@id': personId } : undefined,
};
const creativeWorkStructuredData = creativeWork
  ? {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: creativeWork.name,
      headline: creativeWork.name,
      description: creativeWork.description,
      url: canonical?.href,
      image: shareImage?.href,
      creator: personId ? { '@id': personId } : undefined,
    }
  : undefined;
const serializeStructuredData = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ed" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    {canonical && robots === 'index,follow' && (
      <link rel="canonical" href={canonical} />
    )}
    {robots === 'index,follow' && (
      <>
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={siteConfig.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonical && <meta property="og:url" content={canonical.href} />}
        {shareImage && (
          <>
            <meta property="og:image" content={shareImage.href} />
            <meta
              property="og:image:alt"
              content="Freaks of Nature run crew members pose together on a city street."
            />
            <meta property="og:image:width" content="1290" />
            <meta property="og:image:height" content="969" />
          </>
        )}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {shareImage && <meta name="twitter:image" content={shareImage.href} />}
        <script
          type="application/ld+json"
          set:html={serializeStructuredData(personStructuredData)}
        />
        <script
          type="application/ld+json"
          set:html={serializeStructuredData(websiteStructuredData)}
        />
        {creativeWorkStructuredData && (
          <script
            type="application/ld+json"
            set:html={serializeStructuredData(creativeWorkStructuredData)}
          />
        )}
      </>
    )}
    <link rel="icon" type="image/svg+xml" href={routeHref('/favicon.svg')} />
    <link
      rel="preload"
      href={manropeFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="site-header__inner">
        <a
          class="site-header__brand"
          href={routeHref(homeHref)}
          aria-current={homeIsCurrent ? 'page' : undefined}
        >
          {siteConfig.name}
        </a>
        <span class="site-header__context">
          Brand experience · Community · Partnerships
        </span>
        {navigation.length > 0 && (
          <Navigation label="Primary" items={navigation} />
        )}
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      {reviewLabel && <p class="review-banner shell">{reviewLabel}</p>}
      <slot />
    </main>
    <footer class="site-footer">
      <nav class="site-footer__links" aria-label="Footer">
        {siteConfig.email && (
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        )}
        <a href={siteConfig.linkedin} rel="me">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={routeHref('/archive/')}>Archive</a>
        <a href={routeHref('/about/')}>About</a>
        <a href={routeHref('/work/all-city-mile/#credits')}>
          Photo credit · All City Mile
        </a>
      </nav>
      <span>© {new Date().getFullYear()} Katherine Kalill</span>
    </footer>
    <script>
      import '../scripts/site-navigation';
    </script>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
