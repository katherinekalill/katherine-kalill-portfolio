---
import '../styles/global.css';
import { routeHref } from '../lib/site';
import { siteConfig } from '../lib/site-config';
import {
  createSiteNavigation,
  type SiteNavigationItem,
} from '../lib/navigation';
import Navigation from './Navigation.astro';
import manropeFont from '../assets/fonts/manrope-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  navigation?: SiteNavigationItem[];
  homeHref?: string;
  homeIsCurrent?: boolean;
  reviewLabel?: string | undefined;
  robots?: 'index,follow' | 'noindex,nofollow';
}
const {
  title,
  description,
  navigation = createSiteNavigation(Astro.url.pathname),
  homeHref = '/',
  homeIsCurrent = false,
  reviewLabel,
  robots = 'index,follow',
} = Astro.props;
const canonical = Astro.site
  ? new URL(routeHref(Astro.url.pathname), Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ed" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    {canonical && robots === 'index,follow' && (
      <link rel="canonical" href={canonical} />
    )}
    <link
      rel="preload"
      href={manropeFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="site-header__inner">
        <a
          class="site-header__brand"
          href={routeHref(homeHref)}
          aria-current={homeIsCurrent ? 'page' : undefined}
        >
          {siteConfig.name}
        </a>
        <span class="site-header__context">
          Brand experience · Community · Partnerships
        </span>
        {navigation.length > 0 && (
          <Navigation label="Primary" items={navigation} />
        )}
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      {reviewLabel && <p class="review-banner shell">{reviewLabel}</p>}
      <slot />
    </main>
    <footer class="site-footer">
      {siteConfig.email && (
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      )}
      <a href={siteConfig.linkedin} rel="me">
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <span>© {new Date().getFullYear()} Katherine Kalill</span>
    </footer>
    <script>
      import '../scripts/site-navigation';
    </script>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
