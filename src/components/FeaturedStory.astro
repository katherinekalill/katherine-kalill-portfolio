---
import MediaFrame from './MediaFrame.astro';

interface Props {
  id: string;
  title: string;
  clientPlatform?: string | null;
  operatingContext?: string | null;
  teaser: string;
  href: string;
  previewImage?: string | undefined;
  image?:
    | {
        src: string;
        width: number;
        height: number;
        focalPoint: { x: number; y: number };
        alt: string;
        srcSet?: string | undefined;
        sizes?: string | undefined;
      }
    | undefined;
}

const {
  id,
  title,
  clientPlatform,
  operatingContext,
  teaser,
  href,
  image,
  previewImage,
} = Astro.props;
const teaserId = `story-teaser-${id}`;
const clientId = clientPlatform ? `story-client-${id}` : undefined;
const contextId = operatingContext ? `story-context-${id}` : undefined;
---

<li class="featured-story" data-project-id={id}>
  <article>
    <a
      class="featured-story__link"
      href={href}
      aria-labelledby={`story-${id}`}
      aria-describedby={[clientId, contextId, teaserId]
        .filter(Boolean)
        .join(' ')}
    >
      <div class="featured-story__image" data-reveal="image">
        {previewImage ? (
          <MediaFrame
            src={previewImage}
            alt=""
            decorative
            width={1200}
            height={800}
            hoverZoom
            caption="Synthetic image study for layout review"
          />
        ) : image ? (
          <MediaFrame
            src={image.src}
            srcSet={image.srcSet}
            sizes={image.sizes}
            alt={image.alt}
            width={image.width}
            height={image.height}
            focalPoint={image.focalPoint}
            parallax
            hoverZoom
          />
        ) : (
          <div class="featured-story__empty" aria-hidden="true"></div>
        )}
      </div>
      <div class="featured-story__copy">
        <h3 class="featured-story__title" id={`story-${id}`}>
          {title}
        </h3>
        {clientPlatform && (
          <p class="featured-story__client" id={clientId}>
            <span>With</span> {clientPlatform}
          </p>
        )}
        {operatingContext && (
          <p class="featured-story__context" id={contextId}>
            <span>Context</span> {operatingContext}
          </p>
        )}
        <p class="featured-story__teaser" id={teaserId}>
          {teaser}
        </p>
        <span class="featured-story__visit" aria-hidden="true">
          Explore story ↗
        </span>
      </div>
    </a>
  </article>
</li>
